# ==============================================================
# RAZE Platform — Environment Configuration
# ==============================================================

# Server Port
PORT=4000

# OpenAI API Key (Kept secure on the server, NEVER exposed to Vite frontend)
# Set your actual key here to enable live GPT-4o / GPT-4o-mini evidence reasoning:
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Selection (defaults to gpt-4o-mini; can also use gpt-4o)
OPENAI_MODEL=gpt-4o-mini
